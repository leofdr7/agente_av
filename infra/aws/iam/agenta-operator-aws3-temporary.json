{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateOnlyNamedProductionSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:CreateSecret",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": [
        "arn:aws:secretsmanager:us-east-2:964862484349:secret:agenta/production/ANTHROPIC_API_KEY-??????",
        "arn:aws:secretsmanager:us-east-2:964862484349:secret:agenta/production/SUPABASE_SERVICE_KEY-??????",
        "arn:aws:secretsmanager:us-east-2:964862484349:secret:agenta/production/CLERK_SECRET_KEY-??????",
        "arn:aws:secretsmanager:us-east-2:964862484349:secret:agenta/production/OPENAI_API_KEY-??????"
      ]
    },
    {
      "Sid": "ListSecretsForAws3Validation",
      "Effect": "Allow",
      "Action": "secretsmanager:ListSecrets",
      "Resource": "*"
    },
    {
      "Sid": "SetAndVerifyOnlyTaskExecutionInlinePolicy",
      "Effect": "Allow",
      "Action": [
        "iam:PutRolePolicy",
        "iam:GetRolePolicy"
      ],
      "Resource": "arn:aws:iam::964862484349:role/ecsTaskExecutionRole"
    }
  ]
}
