APP_NAME=Agente Algebra Vectorial
ENVIRONMENT=development
DEBUG=true
AUTH_DISABLED=false
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service_role_key>

# Clerk (Dashboard → API keys → Frontend API URL + /.well-known/jwks.json)
CLERK_JWKS_URL=https://<instancia>.clerk.accounts.dev/.well-known/jwks.json
# Obligatoria en producción. Nunca usar NEXT_PUBLIC_ para esta clave.
CLERK_SECRET_KEY=
# Opcional: emisor esperado (claim `iss`). Por defecto se deriva de CLERK_JWKS_URL.
# CLERK_ISSUER=https://<instancia>.clerk.accounts.dev
# Orígenes del frontend autorizados (claim `azp` y CORS), separados por coma.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# RAG: embeddings (dimensión 512, alineada con pgvector).
# Proveedor: voyage (recomendado) u openai.
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
# OPENAI_API_KEY=
# EMBEDDING_MODEL=voyage-4-lite
# Ruta al vault de Obsidian. Por defecto: <repo>/vault
# VAULT_PATH=

# Agente: orquestador Claude con tool use (no resuelve AX=B por su cuenta).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# Informes: bucket privado de Supabase Storage y TTL de las URLs firmadas (7 días).
REPORTS_BUCKET=reports
REPORTS_SIGNED_URL_TTL_SECONDS=604800

# Tope de estimaciones por empleado y hora (slowapi). Evita costos inesperados de Anthropic.
RATE_LIMIT_ENABLED=true
ESTIMATION_RATE_LIMIT=10/hour
